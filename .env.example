# Copy this file to .env and edit. .env is git-ignored; never commit secrets.
# Real environment variables always override values in this file.
# Empty values mean "use the default".

# Letters, digits, - and _ only
APP_NAME=omolar
# development, test or production
APP_ENV=development
# Must be false in production
DEBUG=false

# Leave HOST empty to listen on all interfaces; 127.0.0.1 for local only
HOST=
PORT=4000

# Durations: 300ms, 15s, 2m, 1h
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# debug, info, warn or error
LOG_LEVEL=info
# text (for humans) or json (for log tools)
LOG_FORMAT=text
